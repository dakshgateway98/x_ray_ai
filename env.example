# Database Configuration
DATABASE_URL=postgresql://xray_user:xray_password@db:5432/xray_diagnosis
POSTGRES_DB=xray_diagnosis
POSTGRES_USER=xray_user
POSTGRES_PASSWORD=xray_password

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# AI Model Configuration
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
SERPAPI_API_KEY=your_serpapi_key_here

# Vector Store Configuration
VECTOR_STORE_TYPE=chroma  # Options: chroma, faiss, pinecone
CHROMA_PERSIST_DIRECTORY=/app/vector_store
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=xray-diagnosis

# Application Configuration
API_HOST=0.0.0.0
API_PORT=8000
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# File Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes 